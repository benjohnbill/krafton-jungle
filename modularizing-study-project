// ============= After =============

// 1. 불완전 타입 선언 (내부 멤버 숨김)
typedef struct _subject Sub;
typedef struct _Record Rec;

// 2. 콜백 함수 포인터 타입 및 순회 함수 선언
typedef void (*result)(const char *name, int minutes);
