### [record.c의 변화]

// ============= Before =============

// 아무것도 없었음

// ============= After =============

// 1. 실제 구조체 본체 정의 (record.c 내부에서만 접근 가능)
struct _subject {
    int minutes;
    char *name;
};

struct _Record {
    size_t count;
    size_t capacity;
    Sub **list;
};

// 2. 순회 엔진 구현
void print_result(const Rec *r, result func){
    if (!r || !func) return;
    for (size_t i = 0; i < r->count; i++){
        func(r->list[i]->name, r->list[i]->minutes);
    }
}
