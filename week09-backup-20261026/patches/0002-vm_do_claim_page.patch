diff --git a/pintos/vm/vm.c b/pintos/vm/vm.c
index 731fe83..d29cadc 100644
--- a/pintos/vm/vm.c
+++ b/pintos/vm/vm.c
@@ -1,9 +1,15 @@
 /* vm.c: Generic interface for virtual memory objects. */
 
+#include "debug.h"
 #include "hash.h"
